4\u0430\u043d\u0456 \u0432 \u041a\u0430\u0441\u0442\u043e\u043c\u0430\u0439\u0437\u0435\u0440\u0456."],"Cards in this carousel":["\u041a\u0430\u0440\u0442\u043a\u0438 \u0446\u0456\u0454\u0457 \u043a\u0430\u0440\u0443\u0441\u0435\u043b\u0456"],"Choose images here to show different products on this page. Leave it empty and the site-wide cards are used.":["\u041e\u0431\u0435\u0440\u0456\u0442\u044c \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f \u0442\u0443\u0442, \u0449\u043e\u0431 \u043d\u0430 \u0446\u0456\u0439 \u0441\u0442\u043e\u0440\u0456\u043d\u0446\u0456 \u0431\u0443\u043b\u0438 \u0456\u043d\u0448\u0456 \u0442\u043e\u0432\u0430\u0440\u0438. \u041f\u043e\u0440\u043e\u0436\u043d\u0454 \u2014 \u0431\u0435\u0440\u0443\u0442\u044c\u0441\u044f \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u043e\u0441\u0430\u0439\u0442\u043e\u0432\u0456 \u043a\u0430\u0440\u0442\u043a\u0438."],"Edit the site-wide cards in the Customizer":["\u0420\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u0442\u0438 \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u043e\u0441\u0430\u0439\u0442\u043e\u0432\u0456 \u043a\u0430\u0440\u0442\u043a\u0438 \u0432 \u041a\u0430\u0441\u0442\u043e\u043c\u0430\u0439\u0437\u0435\u0440\u0456"],"Override the heading here":["\u041f\u0435\u0440\u0435\u0432\u0438\u0437\u043d\u0430\u0447\u0438\u0442\u0438 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a \u0442\u0443\u0442"],"Off: this block uses the site-wide title and subtitle.":["\u0412\u0438\u043c\u043a\u043d\u0435\u043d\u043e: \u0431\u043b\u043e\u043a \u0431\u0435\u0440\u0435 \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u0438\u0439 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a \u0456 \u043f\u0456\u0434\u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a \u0441\u0430\u0439\u0442\u0443."],"Subtitle":["\u041f\u0456\u0434\u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a"],"Leave empty to hide it.":["\u0417\u0430\u043b\u0438\u0448\u0442\u0435 \u043f\u043e\u0440\u043e\u0436\u043d\u0456\u043c, \u0449\u043e\u0431 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u0442\u0438."],"Always off for visitors who ask for reduced motion.":["\u0417\u0430\u0432\u0436\u0434\u0438 \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043e \u0434\u043b\u044f \u0432\u0456\u0434\u0432\u0456\u0434\u0443\u0432\u0430\u0447\u0456\u0432, \u044f\u043a\u0456 \u043f\u0440\u043e\u0441\u044f\u0442\u044c \u0437\u043c\u0435\u043d\u0448\u0438\u0442\u0438 \u0430\u043d\u0456\u043c\u0430\u0446\u0456\u044e."],"Applies when there are fewer than five cards.":["\u0414\u0456\u0454, \u043a\u043e\u043b\u0438 \u043a\u0430\u0440\u0442\u043e\u043a \u043c\u0435\u043d\u0448\u0435 \u043f'\u044f\u0442\u0438."],"Drops the card frame. For cut-out PNGs.":["\u041f\u0440\u0438\u0431\u0438\u0440\u0430\u0454 \u0440\u0430\u043c\u043a\u0443 \u043a\u0430\u0440\u0442\u043a\u0438. \u0414\u043b\u044f PNG \u0437 \u0432\u0438\u0440\u0456\u0437\u0430\u043d\u0438\u043c \u0444\u043e\u043d\u043e\u043c."],"No cards yet. Add at least one product image in the Customizer.":["\u0429\u0435 \u043d\u0435\u043c\u0430\u0454 \u043a\u0430\u0440\u0442\u043e\u043a. \u0414\u043e\u0434\u0430\u0439\u0442\u0435 \u0445\u043e\u0447\u0430 \u0431 \u043e\u0434\u043d\u0435 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f \u0442\u043e\u0432\u0430\u0440\u0443 \u0432 \u041a\u0430\u0441\u0442\u043e\u043c\u0430\u0439\u0437\u0435\u0440\u0456."],"Open the Customizer":["\u0412\u0456\u0434\u043a\u0440\u0438\u0442\u0438 \u041a\u0430\u0441\u0442\u043e\u043c\u0430\u0439\u0437\u0435\u0440"]}}}